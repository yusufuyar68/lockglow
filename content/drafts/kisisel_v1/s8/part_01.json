          "gloss": "boş ver",
          "alt": [
            "önemli değil",
            "neyse"
          ],
          "equivalence": "partial",
          "false_friend": null,
          "note": "'Boş ver' ve 'neyse' çoğu zaman bu işi görür. Biri özür dilediğinde 'önemli değil' demek de 'never mind' ile anlatılabilir. Soru sorup vazgeçerken de 'never mind' denir.",
          "mistakes": [],
          "mnemonic": "'Mind' burada 'kafaya takmak' demek ('Do you mind?' gibi): never mind = hiç kafana takma, boş ver."
        }
      },
