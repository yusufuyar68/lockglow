        "uk": "/ˌnɛvə ˈmaɪnd/"
      },
      "def": {
        "micro": "it is not important",
        "short": "used to say that something is not important, or to stop asking for something",
        "long": "You say this when a small problem is not important, or when you do not want an answer to your question any more. You can also use it to comfort a friend."
      },
      "examples": [
        {
          "en": "“Sorry, I'm late.” “Never mind. We have time.”",
          "tr": "“Geç kaldım, özür dilerim.” “Boş ver. Vaktimiz var.”",
          "register": "neutral",
          "focus": "Never mind"
        },
        {
          "en": "Where is my pen? Oh, never mind. I found it.",
          "tr": "Kalemim nerede? Ha, boş ver. Buldum.",
          "register": "neutral",
          "focus": "never mind"
        },
        {
          "en": "Never mind, Ayşe. You can try again tomorrow.",
          "tr": "Boş ver Ayşe, yarın tekrar deneyebilirsin.",
          "register": "neutral",
          "focus": "Never mind"
        }
      ],
      "synonyms": [],
