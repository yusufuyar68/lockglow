    {
      "id": "en.it_depends.phr.1",
      "lemma": "it depends",
      "type": "phrase",
      "pos": "phr",
      "sense_no": 1,
      "sense_note": "the answer is not always the same",
      "level": "A2",
      "level_source": "editorial_estimate",
      "freq": null,
      "ipa": {
        "us": "/ɪt dɪˈpɛndz/",
        "uk": "/ɪt dɪˈpɛndz/"
      },
      "def": {
        "micro": "not always the same answer",
        "short": "used when you cannot say yes or no because the answer changes with the situation",
        "long": "You say this when you cannot give a simple 'yes' or 'no' answer. The answer changes with the weather, the price, the person or something else. Say what it changes with after 'on'."
      },
      "grammar": {
        "pattern": "It depends (on + noun)"
      },
      "examples": [
        {
          "en": "“Is the bus faster?” “It depends on the traffic.”",
          "tr": "“Otobüs daha mı hızlı?” “Trafiğe bağlı.”",
          "register": "neutral",
          "focus": "It depends on"
        },
        {
          "en": "“Will you come to the party?” “It depends. I may have to work.”",
          "tr": "“Partiye gelecek misin?” “Duruma göre. Çalışmam gerekebilir.”",
          "register": "neutral",
          "focus": "It depends"
        },
        {
          "en": "“How much is a taxi to the airport?” “It depends on the time.”",
          "tr": "“Havalimanına taksi ne kadar?” “Saate bağlı.”",
          "register": "neutral",
          "focus": "It depends on"
        }
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "it depends on the weather",
        "that depends"
      ],
      "word_family": [],
      "etymology": null,
      "l1": {
        "tr": {
          "gloss": "duruma bağlı",
          "alt": [
            "duruma göre",
            "değişir",
            "ona göre"
          ],
          "equivalence": "full",
          "false_friend": null,
          "note": "'It depends' tek başına da söylenir. Neye bağlı olduğunu söylemek için 'on' eklenir: 'It depends on the weather' = 'Havaya bağlı'.",
          "mistakes": [
            {
              "wrong": "It depends the weather.",
              "right": "It depends on the weather.",
              "why": "Türkçede 'havaya bağlı' derken -a eki yeter. İngilizcede ise ek yerine 'on' gerekir: depends on."
            }
          ],
          "mnemonic": "'Depend', 'pandantif' ile aynı 'asılı durmak' kökünden: cevap bir şeye asılıdır, o yüzden 'depends on' denir."
        }
      },
