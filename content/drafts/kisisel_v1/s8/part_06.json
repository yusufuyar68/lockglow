      },
      "def": {
        "micro": "ahead of; facing something",
        "short": "ahead of someone or something, or facing it, not behind or beside it",
        "long": "In the place that someone or something faces, not behind it or at its side. You use it for people, buildings and objects."
      },
      "examples": [
        {
          "en": "The bus stop is in front of the school.",
          "tr": "Otobüs durağı okulun önünde.",
          "register": "neutral",
          "focus": "in front of"
        },
        {
          "en": "Mehmet is standing in front of the mirror.",
          "tr": "Mehmet aynanın önünde duruyor.",
          "register": "neutral",
          "focus": "in front of"
        },
        {
          "en": "Please don't park your car in front of my house.",
          "tr": "Lütfen arabanı evimin önüne park etme.",
          "register": "neutral",
          "focus": "in front of"
        }
      ],
