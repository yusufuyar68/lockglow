    {
      "id": "en.a_few.phr.1",
      "lemma": "a few",
      "type": "phrase",
      "pos": "phr",
      "sense_no": 1,
      "sense_note": "a small number",
      "level": "A2",
      "level_source": "editorial_estimate",
      "freq": null,
      "ipa": {
        "us": "/ə ˈfjuː/",
        "uk": "/ə ˈfjuː/"
      },
      "def": {
        "micro": "a small number of",
        "short": "used before a plural noun to say there are some, but not many",
        "long": "You use it before a plural noun to talk about a small number of people or things. It is a positive idea: you have some, and that is enough."
      },
      "grammar": {
        "pattern": "a few + plural noun"
      },
      "examples": [
        {
          "en": "I have a few questions.",
          "tr": "Birkaç sorum var.",
          "register": "neutral",
          "focus": "a few"
        },
        {
          "en": "Mehmet bought a few apples at the market.",
          "tr": "Mehmet pazardan birkaç elma aldı.",
          "register": "neutral",
          "focus": "a few"
        },
        {
          "en": "We need a few more minutes, Elif.",
          "tr": "Bize birkaç dakika daha lazım Elif.",
          "register": "neutral",
          "focus": "a few"
        }
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "a few days",
        "a few minutes"
      ],
      "word_family": [],
      "etymology": null,
      "l1": {
        "tr": {
          "gloss": "birkaç",
          "alt": [
            "birkaç tane",
            "bir iki"
          ],
          "equivalence": "partial",
          "false_friend": null,
          "note": "'A few' olumlu anlam taşır: birkaç var ve yeter. 'Few' ise (a olmadan) 'neredeyse hiç yok' demektir. Yalnızca çoğul sayılabilen isimlerle kullanılır: 'a few books'.",
          "mistakes": [
            {
              "wrong": "I have few questions.",
              "right": "I have a few questions.",
              "why": "Türkçede 'birkaç' ve 'az' ayrı sözlerdir. 'Few' (a olmadan) 'neredeyse hiç' demektir; 'birkaç' için 'a few' gerekir."
            }
          ],
          "mnemonic": "'A' gidince elde neredeyse hiç kalmaz: 'a few' = birkaç tane var, 'few' = neredeyse hiç."
        }
      },
      "tags": {
        "primary_topic": "confusing_words",
        "topics": [
          "confusing_words"
        ],
        "exams": [],
        "register": "neutral",
        "vibes": [],
        "flags": [],
        "sensitivity": 0
      },
