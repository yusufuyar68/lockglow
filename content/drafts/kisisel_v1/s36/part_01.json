        "short": "used to compare two facts and show that the second is different from the first",
        "long": "Used to join two facts that are true at the same time and to show how they are different. It is common in formal and academic writing."
      },
      "grammar": {
        "pattern": "X, whereas Y"
      },
      "examples": [
        {
          "en": "Elif loves cities, whereas her brother prefers the countryside.",
          "tr": "Elif şehirleri severken kardeşi kırsalı tercih ediyor.",
          "register": "formal",
          "focus": "whereas"
        },
        {
          "en": "Some animals are active during the day, whereas others hunt at night.",
          "tr": "Bazı hayvanlar gündüz etkinken diğerleri geceleri avlanır.",
          "register": "formal",
          "focus": "whereas"
        },
        {
          "en": "Men's wages rose by 5 percent, whereas women's wages stayed the same.",
          "tr": "Erkeklerin maaşları yüzde 5 artarken kadınların maaşları aynı kaldı.",
          "register": "formal",
          "focus": "whereas"
        }
