        {
          "en": "Do you get along with your brother?",
          "tr": "Kardeşinle iyi anlaşıyor musun?",
          "register": "neutral",
          "focus": "get along with"
        },
        {
          "en": "The two cats don't get along at all.",
          "tr": "İki kedi hiç anlaşamıyor.",
          "register": "neutral",
          "focus": "get along"
        }
      ],
      "synonyms": [],
      "antonyms": [
        "argue with"
      ],
      "collocations": [
        "get along well",
        "get along with sb",
        "get along with your family",
        "get along great"
      ],
      "word_family": [],
      "etymology": null,
