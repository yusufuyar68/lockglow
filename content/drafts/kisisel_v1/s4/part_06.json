    {
      "id": "en.carry_on.phv.1",
      "lemma": "carry on",
      "type": "phrasal_verb",
      "pos": "phv",
      "sense_no": 1,
      "sense_note": "continue",
      "level": "B1",
      "level_source": "editorial_estimate",
      "freq": null,
      "ipa": {
        "us": "/ˌkæri ˈɑːn/",
        "uk": "/ˌkæri ˈɒn/"
      },
      "def": {
        "micro": "keep going",
        "short": "keep doing something and not stop",
        "long": "To keep doing something, or to keep going on your way. It is often used to tell someone to continue politely: 'Sorry to interrupt. Please carry on.'"
      },
      "grammar": {
        "pattern": "carry on (+ -ing / with sth)"
      },
      "examples": [
        {
          "en": "Sorry to interrupt. Please carry on.",
          "tr": "Bölüyorum, özür dilerim. Lütfen devam edin.",
          "register": "neutral",
          "focus": "carry on"
        },
        {
          "en": "We carried on walking in the rain.",
          "tr": "Yağmurda yürümeye devam ettik.",
          "register": "neutral",
          "focus": "carried on"
        },
        {
          "en": "Carry on with your work. I'll be back soon.",
          "tr": "İşine devam et. Birazdan döneceğim.",
          "register": "neutral",
          "focus": "Carry on"
        }
      ],
      "synonyms": [
        "continue",
        "keep going"
      ],
      "antonyms": [
        "stop",
        "give up"
      ],
      "collocations": [
        "carry on working",
        "carry on talking",
        "carry on as usual",
        "carry on with sth"
      ],
      "word_family": [],
      "etymology": null,
      "l1": {
        "tr": {
          "gloss": "devam etmek",
          "alt": [
            "sürdürmek"
          ],
          "equivalence": "full",
          "false_friend": null,
          "note": "'Carry on' + fiil-ing ('carry on working') ya da 'carry on with' + isim ('carry on with your work') kalıbıyla kullanılır. 'Keep on' ve 'go on' benzer anlamdadır.",
          "mistakes": [
            {
              "wrong": "I will carry on to study.",
              "right": "I will carry on studying.",
              "why": "Türkçedeki '-meye devam etmek' İngilizcede 'carry on + -ing' olur. 'To + fiil' kullanılmaz."
            }
          ],
          "mnemonic": "Carry = taşımak, on = devam (go on, keep on gibi): yükü bırakmadan taşımaya devam edersin."
        }
      },
      "tags": {
        "primary_topic": "phrasal_verbs",
        "topics": [
          "phrasal_verbs",
          "success_productivity"
        ],
        "exams": [],
        "register": "neutral",
        "vibes": [],
        "flags": [
          "intransitive"
        ],
        "sensitivity": 0
      },
