    {
      "id": "en.set_up.phv.1",
      "lemma": "set up",
      "type": "phrasal_verb",
      "pos": "phv",
      "sense_no": 1,
      "sense_note": "make a device or account ready",
      "level": "B1",
      "level_source": "editorial_estimate",
      "freq": null,
      "ipa": {
        "us": "/sɛt ˈʌp/",
        "uk": "/sɛt ˈʌp/"
      },
      "def": {
        "micro": "make ready to use",
        "short": "make a phone, account or machine ready to use",
        "long": "To prepare something so that it is ready to use, such as a phone, an app, an account or a piece of equipment. The noun is 'setup'."
      },
      "grammar": {
        "pattern": "set sth up / set up sth (set it up)"
      },
      "examples": [
        {
          "en": "I need to set up my new phone.",
          "tr": "Yeni telefonumu kurmam gerekiyor.",
          "register": "neutral",
          "focus": "set up"
        },
        {
          "en": "Can you help me set up the Wi-Fi?",
          "tr": "Wi-Fi'yi kurmama yardım eder misin?",
          "register": "neutral",
          "focus": "set up"
        },
        {
          "en": "Ali set the printer up in five minutes.",
          "tr": "Ali yazıcıyı beş dakikada kurdu.",
          "register": "neutral",
          "focus": "set the printer up"
        }
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
        "set up an account",
        "set up a phone",
        "set up Wi-Fi",
        "set up the printer",
        "set up a password"
      ],
      "word_family": [
