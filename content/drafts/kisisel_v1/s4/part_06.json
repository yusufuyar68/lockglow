          "gloss": "kurmak",
          "alt": [
            "ayarlamak",
            "kurulum yapmak"
          ],
          "equivalence": "partial",
          "false_friend": null,
          "note": "Cihaz ve hesap için 'kurmak', ayarlarını yapmak için 'ayarlamak' denir. 'Set up' ayrıca toplantı ya da şirket kurmak için de kullanılır.",
          "mistakes": [
            {
              "wrong": "Please set up the alarm at six.",
              "right": "Please set the alarm for six.",
              "why": "Alarm için 'set the alarm' denir. 'Set up' bir cihazı ya da hesabı ilk kez hazırlamaktır."
            },
            {
              "wrong": "Set up it, please.",
              "right": "Set it up, please.",
              "why": "Zamir (it, them) 'set' ile 'up' arasına girer."
            }
          ],
          "mnemonic": null
        }
      },
