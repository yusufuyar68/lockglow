      },
      "def": {
        "micro": "use all of something",
        "short": "use all of something so that there is none left",
        "long": "To use all of something so that there is no more. It can be time, money, milk, battery or patience. The subject is the person who has none left: 'We ran out of milk.'"
      },
      "grammar": {
        "pattern": "run out of + sth (inseparable)"
      },
      "examples": [
        {
          "en": "We've run out of milk.",
          "tr": "Sütümüz bitti.",
          "register": "neutral",
          "focus": "run out of"
