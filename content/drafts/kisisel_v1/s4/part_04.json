            "tükenmek"
          ],
          "equivalence": "partial",
          "false_friend": null,
          "note": "Türkçede özne şeydir ('Sütümüz bitti'), İngilizcede özne kişidir ('We ran out of milk' = biz sütsüz kaldık). Cümleyi kişiyle kurun.",
          "mistakes": [
            {
              "wrong": "The sugar is finished.",
              "right": "We've run out of sugar.",
              "why": "Türkçede 'şeker bitti' deriz. İngilizcede 'finish' bir işi bitirmektir; bir şeyin kalmaması için 'run out of' kullanılır."
            },
            {
              "wrong": "We ran out milk.",
              "right": "We ran out of milk.",
              "why": "'Of' atlanmaz: run out of + isim."
            }
          ],
          "mnemonic": "Kum saatini düşün: kum akar (run), dışarı (out) çıkar ve sonunda hiç kalmaz. 'We ran out of time' de böyle."
        }
      },
