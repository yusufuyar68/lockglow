    {
      "id": "en.hold_on.phv.1",
      "lemma": "hold on",
      "type": "phrasal_verb",
      "pos": "phv",
      "sense_no": 1,
      "sense_note": "wait a short time",
      "level": "A2",
      "level_source": "editorial_estimate",
      "freq": null,
      "ipa": {
        "us": "/hoʊld ˈɑːn/",
        "uk": "/həʊld ˈɒn/"
      },
      "def": {
        "micro": "wait a moment",
        "short": "ask someone to wait for a short time",
        "long": "To wait for a short time. People say 'Hold on' when they need a moment, or on the phone when they ask you to stay on the line. It is informal."
      },
      "grammar": {
        "pattern": "hold on (no object)"
      },
      "examples": [
        {
          "en": "Hold on, I'll be there in a minute.",
          "tr": "Bir dakika, hemen geliyorum.",
          "register": "informal",
          "focus": "Hold on"
        },
        {
          "en": "Hold on a second. I need to find my phone.",
          "tr": "Bir saniye. Telefonumu bulmam lazım.",
          "register": "informal",
          "focus": "Hold on"
        },
        {
          "en": "Can you hold on, please? I'll check for you.",
          "tr": "Bir dakika bekler misiniz? Hemen bakıyorum.",
          "register": "neutral",
          "focus": "hold on"
        }
      ],
      "synonyms": [
        "wait"
      ],
      "antonyms": [],
      "collocations": [
        "Hold on!",
        "hold on a second",
        "hold on a minute",
        "hold on, please"
      ],
      "word_family": [],
      "etymology": null,
      "l1": {
        "tr": {
          "gloss": "bir dakika beklemek",
          "gloss_short": "beklemek",
          "alt": [
            "durmak",
            "hatta kalmak"
          ],
          "equivalence": "partial",
          "false_friend": null,
          "note": "'Hold on!' = 'Bir dakika!' ya da 'Dur bir dakika!'. Telefonda 'Hold on, please' = 'Hatta kalın, bir saniye.' Konuşma dilidir; resmî ortamda 'Please wait' daha uygundur.",
          "mistakes": [
            {
              "wrong": "Hold a minute, please.",
              "right": "Hold on a minute, please.",
              "why": "'Hold' tek başına tutmak demektir. Beklemek için 'hold on' gerekir."
            }
          ],
          "mnemonic": "'Hold' tutmak demek: telefonda hattı tutup kapatmadan beklersin. Telefonda 'Hold the line' (hatta kalın) da denir."
        }
      },
      "tags": {
        "primary_topic": "phrasal_verbs",
        "topics": [
          "phrasal_verbs",
          "social_skills"
        ],
        "exams": [],
        "register": "informal",
        "vibes": [],
        "flags": [
          "intransitive"
        ],
        "sensitivity": 0
      },
      "quiz": {
        "cloze": "Wait! ______ a second. I forgot my bag.",
        "answer": "Hold on",
