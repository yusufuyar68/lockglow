          "en": "I'm running out of battery. Do you have a charger?",
          "tr": "Şarjım bitmek üzere. Şarj aletin var mı?",
          "register": "neutral",
          "focus": "running out of"
        },
        {
          "en": "Ayşe ran out of time and couldn't finish the test.",
          "tr": "Ayşe'nin zamanı bitti ve sınavı bitiremedi.",
          "register": "neutral",
          "focus": "ran out of"
        }
      ],
      "synonyms": [],
      "antonyms": [],
      "confusables": [
        "finish",
        "use up"
      ],
      "collocations": [
