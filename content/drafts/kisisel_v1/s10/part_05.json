    {
      "id": "en.urgent.adj.1",
      "lemma": "urgent",
      "type": "word",
      "pos": "adj",
      "sense_no": 1,
      "sense_note": null,
      "level": "B1",
      "level_source": "editorial_estimate",
      "freq": null,
      "ipa": {
        "us": "/ˈɜːrdʒənt/",
        "uk": "/ˈɜːdʒənt/"
      },
      "def": {
        "micro": "needing action very soon",
        "short": "needing action very soon because it cannot wait",
        "long": "Needing to be done right now, because waiting would cause a problem. We say it about emails, calls and jobs at work. 'Urgent' is not 'important': an important job matters a lot, but it can often wait."
      },
      "grammar": {
        "pattern": "urgent + noun / be urgent"
      },
      "examples": [
        {
          "en": "I have an urgent email to send.",
          "tr": "Göndermem gereken acil bir e-postam var.",
          "register": "neutral",
          "focus": "urgent"
        },
        {
          "en": "Esra marked her message as urgent, so I read it first.",
          "tr": "Esra mesajını acil olarak işaretledi, bu yüzden önce onu okudum.",
          "register": "neutral",
          "focus": "urgent"
        },
        {
          "en": "Leila left the meeting early because of an urgent phone call.",
          "tr": "Leila acil bir telefon yüzünden toplantıdan erken ayrıldı.",
          "register": "neutral",
          "focus": "urgent"
        }
      ],
      "synonyms": [
        "pressing"
      ],
      "antonyms": [],
      "collocations": [
        "an urgent email",
        "an urgent matter",
        "an urgent call",
        "urgent help",
        "urgent action"
      ],
      "word_family": [
        {
          "lemma": "urgently",
          "pos": "adv"
        },
        {
          "lemma": "urgency",
          "pos": "n"
        }
      ],
      "etymology": {
        "text": "From Latin 'urgere', meaning to push or press. An urgent job pushes you to act now.",
        "origin": "Latin",
        "confidence": "high"
      },
      "l1": {
        "tr": {
          "gloss": "acil",
          "alt": [
            "ivedi"
          ],
          "equivalence": "full",
          "false_friend": null,
          "note": "'Acil' hemen yapılması gereken iştir. 'Important' ise 'önemli' demektir; önemli bir iş her zaman acil değildir. 'Acil durum' ve 'acil çıkış' için 'emergency' kullanılır: emergency exit.",
          "mistakes": [],
          "mnemonic": null
        }
      },
