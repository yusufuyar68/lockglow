    {
      "id": "en.postpone.v.1",
      "lemma": "postpone",
      "type": "word",
      "pos": "v",
      "sense_no": 1,
      "sense_note": null,
      "level": "B1",
      "level_source": "editorial_estimate",
      "freq": null,
      "ipa": {
        "us": "/poʊstˈpoʊn/",
        "uk": "/pəʊstˈpəʊn/"
      },
      "def": {
        "micro": "move to a later time",
        "short": "decide that something will happen at a later time",
        "long": "To decide that something will happen at a later time, not at the planned time. It is not cancelled: it still happens, only later. We use it for meetings, trips and decisions."
      },
      "grammar": {
        "pattern": "postpone + noun / -ing"
      },
      "examples": [
        {
          "en": "We have to postpone the meeting.",
          "tr": "Toplantıyı ertelemek zorundayız.",
          "register": "neutral",
          "focus": "postpone"
        },
        {
          "en": "Hakan postponed our meeting until next Monday.",
          "tr": "Hakan toplantımızı gelecek pazartesiye erteledi.",
          "register": "neutral",
          "focus": "postponed"
        },
        {
          "en": "Nina decided to postpone buying new chairs until next month.",
          "tr": "Nina yeni sandalye almayı gelecek aya ertelemeye karar verdi.",
          "register": "neutral",
          "focus": "postpone"
        }
      ],
      "synonyms": [
        "put off"
      ],
      "antonyms": [
        "bring forward"
      ],
      "confusables": [
        "delay"
      ],
      "collocations": [
        "postpone a meeting",
        "postpone a trip",
        "postpone the decision",
        "postpone until Monday"
      ],
      "word_family": [
        {
          "lemma": "postponement",
          "pos": "n"
        }
      ],
      "etymology": {
        "text": "From Latin 'postponere', meaning to put after: 'post' means after and 'ponere' means to put.",
        "origin": "Latin",
        "confidence": "high"
      },
      "l1": {
        "tr": {
          "gloss": "ertelemek",
          "alt": [
            "sonraya bırakmak"
          ],
          "equivalence": "full",
          "false_friend": null,
          "note": "'Postpone' ertelemektir: etkinlik iptal edilmez, daha sonra yapılır. İptal için 'cancel' denir. Tersi, yani öne almak için 'bring forward' kullanılır.",
          "mistakes": [
            {
              "wrong": "We postponed to buy new chairs.",
              "right": "We postponed buying new chairs.",
              "why": "Türkçede 'almayı ertelemek' deriz ve '-mayı' eki 'to buy' gibi çevrilir. Oysa 'postpone' fiilinden sonra 'to + fiil' gelmez, fiil -ing alır: postpone buying."
            }
          ],
          "mnemonic": null
        }
      },
      "tags": {
        "primary_topic": "workplace_office",
        "topics": [
          "workplace_office",
          "time_routines"
        ],
        "exams": [],
        "register": "neutral",
        "vibes": [],
        "flags": [],
        "sensitivity": 0
      },
      "quiz": {
