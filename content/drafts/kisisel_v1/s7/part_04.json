      },
      "def": {
        "micro": "continuing up to now",
        "short": "up to now or then, without stopping or changing",
        "long": "Used when something began in the past and has not stopped. It usually goes before the main verb: 'I still live here.' It can also show surprise."
      },
      "grammar": {
        "pattern": "subject + still + verb"
      },
      "examples": [
        {
          "en": "I still live with my parents.",
          "tr": "Hâlâ annemle babamla yaşıyorum.",
          "register": "neutral",
          "focus": "still"
        },
        {
          "en": "Is it still raining outside?",
          "tr": "Dışarıda hâlâ yağmur yağıyor mu?",
          "register": "neutral",
          "focus": "still"
        },
        {
          "en": "It's midnight, but Mehmet is still working.",
          "tr": "Gece yarısı oldu ama Mehmet hâlâ çalışıyor.",
          "register": "neutral",
          "focus": "still"
        }
      ],
      "synonyms": [],
      "antonyms": [
        "no longer",
        "not any more"
