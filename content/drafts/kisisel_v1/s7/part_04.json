      "etymology": null,
      "l1": {
        "tr": {
          "gloss": "hâlâ",
          "alt": [
            "hâlen"
          ],
          "equivalence": "full",
          "false_friend": null,
          "note": "'Still' = hâlâ. Fiilden önce gelir: I still live here. Olumsuzda 'not' kelimesinden önce gelir: I still haven't finished. 'Yet' = henüz, cümle sonunda olur; ikisini karıştırma.",
          "mistakes": [
            {
              "wrong": "Is she yet at work?",
              "right": "Is she still at work?",
              "why": "Türkçede 'hâlâ' ve 'henüz / daha' yakın kullanılır ('Daha uyuyor' = hâlâ uyuyor), bu yüzden 'yet' seçilir. İngilizcede 'hâlâ' için 'still', 'henüz' için 'yet' denir."
            }
          ],
          "mnemonic": null
        }
