      },
      "def": {
        "micro": "wish to have or do something",
        "short": "to feel that you would like to have or do something",
        "long": "To feel that you would like to have something or do something. We say 'want' and a thing ('I want a coffee') or 'want to' and a verb ('I want to sleep'). It is more direct than 'would like'."
      },
      "grammar": {
        "pattern": "want + sth / want to + verb"
      },
      "examples": [
        {
          "en": "I want a cup of coffee.",
          "tr": "Bir fincan kahve istiyorum.",
          "register": "neutral",
          "focus": "want"
        },
        {
          "en": "Do you want to go to the cinema tonight?",
          "tr": "Bu akşam sinemaya gitmek ister misin?",
          "register": "neutral",
          "focus": "want"
        },
        {
          "en": "Tom doesn't want to cook tonight.",
          "tr": "Tom bu akşam yemek yapmak istemiyor.",
          "register": "neutral",
          "focus": "want"
        }
      ],
      "synonyms": [
        "would like"
      ],
      "antonyms": [],
      "collocations": [
        "want a coffee",
        "want to go",
        "want some help",
        "want more time",
        "want to know"
      ],
      "word_family": [],
      "etymology": {
        "text": "From Old Norse 'vanta', meaning 'to lack'. The meaning slowly changed from 'lack something' to 'wish for something'.",
        "origin": "Old Norse",
        "confidence": "high"
      },
      "l1": {
        "tr": {
          "gloss": "istemek",
          "alt": [],
          "equivalence": "full",
          "false_friend": null,
          "note": "'Want' ile fiil kullanırken 'to' gerekir: I want to go. Kibar isteklerde 'would like' daha uygundur: I'd like a coffee, please.",
          "mistakes": [
            {
              "wrong": "I am wanting a cup of tea.",
              "right": "I want a cup of tea.",
              "why": "Türkçede 'istiyorum' -yor ekiyle (şimdiki zaman) söylenir; bu yüzden 'I'm wanting' denir. 'Want' durum bildiren bir fiildir ve genellikle -ing almaz."
            },
            {
              "wrong": "I want that you help me.",
              "right": "I want you to help me.",
              "why": "Türkçede 'yardım etmeni istiyorum' denir ve fiil ayrı bir ek alır; bu yüzden 'want that' denir. İngilizcede bu yapı 'want' + kişi + to + fiil olur, 'that' ile kurulmaz."
            }
          ],
          "mnemonic": null
        }
      },
      "tags": {
