        {
          "en": "I need a new phone.",
          "tr": "Yeni bir telefona ihtiyacım var.",
          "register": "neutral",
          "focus": "need"
        },
        {
          "en": "Do you need any help with your bags?",
          "tr": "Çantalarınız için yardıma ihtiyacınız var mı?",
          "register": "neutral",
          "focus": "need"
        },
        {
          "en": "Deniz needs to leave early today.",
          "tr": "Deniz'in bugün erken çıkması gerekiyor.",
          "register": "neutral",
          "focus": "needs"
        }
      ],
      "synonyms": [],
      "antonyms": [],
      "collocations": [
