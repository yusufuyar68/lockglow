          "tr": "Birçok 'Ödül kazandınız!' mesajı dolandırıcılıktır.",
          "register": "neutral",
          "focus": "scams"
        },
        {
          "en": "The text said my parcel was waiting, but it was a scam.",
          "tr": "Mesajda kargomun beklediği yazıyordu ama dolandırıcılık çıktı.",
          "register": "neutral",
          "focus": "scam"
        },
        {
          "en": "Kerem lost 2,000 lira in an online shopping scam.",
          "tr": "Kerem bir internet alışverişi dolandırıcılığında 2.000 lira kaybetti.",
          "register": "neutral",
          "focus": "scam"
        }
      ],
      "synonyms": [
        "con"
      ],
      "antonyms": [],
      "collocations": [
