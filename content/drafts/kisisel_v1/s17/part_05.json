      "def": {
        "micro": "a trick to take your money",
        "short": "a dishonest plan to trick people and take their money",
        "long": "A dishonest plan to trick people and take their money, often by phone, text message or email. People often say \"It's a scam\" about a fake offer."
      },
      "grammar": {
        "pattern": "a scam; fall for a scam"
      },
      "examples": [
